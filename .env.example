# ═══════════════════════════════════════════════════════════════
# App / Database
# ═══════════════════════════════════════════════════════════════

# مطلوب: اتصال Postgres (Neon أو غيره). استخدم uselibpqcompat=true&sslmode=require للإنتاج.
DATABASE_URL=postgresql://user:password@host:5432/dbname?uselibpqcompat=true&sslmode=require

# الرابط العام للتطبيق (يُستخدم في الكوكيز والروابط المطلقة).
# في التطوير: http://localhost:3000  |  في الإنتاج: https://your-store.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════
# Owner / Initial Admin (يُستخدم مرة واحدة عند أول seed)
# ═══════════════════════════════════════════════════════════════

# بريد المالك — يُستخدم لإنشاء حساب الأدمن الأول.
OWNER_EMAIL=owner@example.com

# اسم المالك كما يظهر في لوحة التحكم.
OWNER_NAME=اسم المالك

# جوال المالك (10 أرقام، يبدأ بـ 05). اتركه فارغاً إذا لا تريد تخزينه.
OWNER_PHONE=05XXXXXXXX

# كلمة مرور الأدمن الأول (12 حرفاً على الأقل). يُنشأ بها الحساب في أول تشغيل فقط.
INITIAL_ADMIN_PASSWORD=replace_with_strong_password_12_chars_min

# ═══════════════════════════════════════════════════════════════
# Tabby (تقسيط) — Keep the secret key server-side only
# ═══════════════════════════════════════════════════════════════

NEXT_PUBLIC_TABBY_PUBLIC_KEY=pk_test_replace_with_your_public_key
TABBY_SECRET_KEY=sk_test_replace_with_your_secret_key
TABBY_MERCHANT_CODE=replace_with_your_merchant_code

# ⚠️ تحقّق من وثائق Tabby: القيمة الشائعة هي https://api.tabby.ai
# (تم تغييرها مؤخراً إلى https://api.tabby.sa لبعض الحسابات السعودية).
TABBY_API_BASE_URL=https://api.tabby.ai

# سر توقيع webhook — يجب أن يكون طويلاً وعشوائياً (32+ حرفاً).
TABBY_WEBHOOK_SECRET=replace_with_a_long_random_secret

# ═══════════════════════════════════════════════════════════════
# Moyasar (بوابة دفع)
# ═══════════════════════════════════════════════════════════════

# مفاتيح Moyasar يجب أن تكون من نفس البيئة (test أو live).
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
MOYASAR_SECRET_KEY=sk_test_replace_with_your_secret_key

# ═══════════════════════════════════════════════════════════════
# Tamara (تقسيط) — Sandbox افتراضياً
# ═══════════════════════════════════════════════════════════════

TAMARA_TOKEN_SECRET=replace_with_tamara_api_token
TAMARA_NOTIFICATION_TOKEN=replace_with_tamara_notification_token
TAMARA_API_BASE_URL=https://api-sandbox.tamara.co

# ═══════════════════════════════════════════════════════════════
# Payment Credentials Encryption
# ═══════════════════════════════════════════════════════════════

# مطلوب: مفتاح تشفير لمفاتيح الدفع المحفوظة في قاعدة البيانات.
# ولّده بأمان عبر: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ لا تفقده بعد أول تشغيل — فقدانه يعني فقدان مفاتيح الدفع المشفّرة.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=replace_with_64_char_random_hex

# ═══════════════════════════════════════════════════════════════
# Supabase Storage (للإيصالات البنكية)
# ═══════════════════════════════════════════════════════════════

# أنشئ Bucket باسم payment-receipts في Supabase كـ Private.
# احتفظ بـ Service Role Key على الخادم فقط — لا تضع له بادئة NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
SUPABASE_STORAGE_BUCKET=payment-receipts