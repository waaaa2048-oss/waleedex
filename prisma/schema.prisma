generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StoreType {
  SLAUGHTERHOUSE
  CLOTHING
  GROCERY
  FROZEN
}

enum StoreStatus {
  PRIVATE
  DRAFT
  PUBLISHED
}

model stores {
  id         Int        @id @default(autoincrement())
  name       String
  slug       String     @unique
  store_type StoreType  @default(SLAUGHTERHOUSE)
  status     StoreStatus @default(PUBLISHED)
  logo_url   String?
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)

  products  products[]
  categories categories[]
  orders    orders[]
  reviews   reviews[]
}

model activity_logs {
  id         Int      @id @default(autoincrement())
  actor_name String   @default("النظام")
  action     String
  entity     String   @default("عام")
  entity_id  String?
  details    String   @default("")
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model app_releases {
  id            Int      @id @default(autoincrement())
  release_group String
  platform      String
  version       String
  notes         String   @default("")
  artifact_url  String?
  status        String   @default("draft")
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
}

model categories {
  id           Int      @id @default(autoincrement())
  store_id     Int?     @default(1)
  name         String
  slug         String
  blurb        String   @default("")
  image_url    String?
  sort_order   Int      @default(0)
  is_active    Boolean  @default(true)
  is_highlight Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  store stores? @relation(fields: [store_id], references: [id], onDelete: Cascade)
}

model coupons {
  id          Int       @id @default(autoincrement())
  code        String    @unique(map: "coupons_code_unique")
  type        String    @default("percent")
  value       Decimal   @default(0) @db.Decimal(10, 2)
  min_order   Decimal   @default(0) @db.Decimal(10, 2)
  usage_limit Int       @default(0)
  used_count  Int       @default(0)
  description String    @default("")
  expires_at  DateTime? @db.Date
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
}

model customer_sessions {
  token       String    @id
  customer_id Int
  expires_at  DateTime  @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_sessions_customer_id_customers_id_fk")
}

model customers {
  id                Int                 @id @default(autoincrement())
  name              String
  phone             String
  email             String?
  city              String              @default("الرياض")
  address           String?
  notes             String?
  password_hash     String?
  is_vip            Boolean             @default(false)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  customer_sessions customer_sessions[]
  orders            orders[]
  reviews           reviews[]
}

model integrations {
  id         Int      @id @default(autoincrement())
  key        String   @unique(map: "integrations_key_unique")
  name       String
  category   String   @default("أدوات")
  url        String   @default("")
  account_id String?
  is_enabled Boolean  @default(false)
  notes      String   @default("")
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model order_items {
  id          Int       @id @default(autoincrement())
  order_id    Int
  product_id  Int?
  name        String
  animal_type String    @default("خروف")
  quantity    Int       @default(1)
  weight_kg   Decimal   @default(0) @db.Decimal(8, 2)
  unit_price  Decimal   @default(0) @db.Decimal(10, 2)
  line_total  Decimal   @default(0) @db.Decimal(12, 2)
  orders      orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "order_items_order_id_orders_id_fk")
  products    products? @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "order_items_product_id_products_id_fk")
}

model order_services {
  id         Int       @id @default(autoincrement())
  order_id   Int
  service_id Int?
  name       String
  quantity   Int       @default(1)
  unit_price Decimal   @default(0) @db.Decimal(10, 2)
  line_total Decimal   @default(0) @db.Decimal(12, 2)
  orders     orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "order_services_order_id_orders_id_fk")
  services   services? @relation(fields: [service_id], references: [id], onUpdate: NoAction, map: "order_services_service_id_services_id_fk")
}

model orders {
  id                     Int              @id @default(autoincrement())
  store_id               Int?             @default(1)
  code                   String           @unique(map: "orders_code_unique")
  customer_id            Int
  status                 String           @default("new")
  fulfillment            String           @default("delivery")
  delivery_date          DateTime?        @db.Date
  delivery_address       String?
  notes                  String?
  total_amount           Decimal          @default(0) @db.Decimal(12, 2)
  paid_amount            Decimal          @default(0) @db.Decimal(12, 2)
  payment_method         String           @default("cash")
  created_at             DateTime         @default(now()) @db.Timestamptz(6)
  updated_at             DateTime         @default(now()) @db.Timestamptz(6)
  delivery_fee           Decimal          @default(0) @db.Decimal(10, 2)
  tabby_payment_id       String?          @unique
  tabby_payment_status   String           @default("not_started")
  payment_receipt_path   String?
  tamara_order_id        String?          @unique
  tamara_payment_status  String           @default("not_started")
  moyasar_payment_id     String?          @unique
  moyasar_payment_status String           @default("not_started")
  order_items            order_items[]
  order_services         order_services[]
  customers              customers        @relation(fields: [customer_id], references: [id], onUpdate: NoAction, map: "orders_customer_id_customers_id_fk")
  shipments              shipments[]

  store stores? @relation(fields: [store_id], references: [id], onDelete: Cascade)
}

model product_inventory_movements {
  id             Int       @id @default(autoincrement())
  product_id     Int?
  product_name   String
  previous_stock Int
  new_stock      Int
  reason         String    @default("تعديل يدوي")
  actor_name     String    @default("النظام")
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  products       products? @relation(fields: [product_id], references: [id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)])
}

model products {
  id                          Int                           @id @default(autoincrement())
  store_id                    Int?                          @default(1)
  sku                         String                        @unique
  name                        String
  animal_type                 String                        @default("خروف")
  category                    String                        @default("النعيمي الكشميري")
  kind                        String                        @default("ready")
  description                 String                        @default("")
  weight_kg                   Decimal                       @default(0) @db.Decimal(8, 2)
  price_per_kg                Decimal                       @default(0) @db.Decimal(10, 2)
  fixed_price                 Decimal?                      @db.Decimal(10, 2)
  stock                       Int                           @default(0)
  image_url                   String?
  origin                      String                        @default("")
  is_active                   Boolean                       @default(true)
  is_featured                 Boolean                       @default(false)
  created_at                  DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                      @default(now()) @db.Timestamptz(6)
  order_items                 order_items[]
  product_inventory_movements product_inventory_movements[]
  product_modifiers           product_modifiers[]
  reviews                     reviews[]

  store stores? @relation(fields: [store_id], references: [id], onDelete: Cascade)
}

model product_modifiers {
  id         Int      @id @default(autoincrement())
  product_id Int
  name       String
  type       String   @default("select")
  required   Boolean  @default(false)
  options    Json     @default("[]")
  created_at DateTime @default(now()) @db.Timestamptz(6)

  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)
}

model reviews {
  id         Int      @id @default(autoincrement())
  store_id   Int?     @default(1)
  product_id Int?
  customer_id Int?
  rating     Int      @default(5)
  comment    String   @default("")
  created_at DateTime @default(now()) @db.Timestamptz(6)

  store    stores?    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  product  products?  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  customer customers? @relation(fields: [customer_id], references: [id], onDelete: SetNull)
}

model services {
  id             Int              @id @default(autoincrement())
  name           String
  type           String           @default("طبخ")
  description    String           @default("")
  price          Decimal          @default(0) @db.Decimal(10, 2)
  unit           String           @default("للطلب")
  is_active      Boolean          @default(true)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  order_services order_services[]
}

model sessions {
  token      String   @id
  user_id    Int
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sessions_user_id_users_id_fk")
}

model shipments {
  id                   Int                @id @default(autoincrement())
  order_id             Int
  carrier_id           Int?
  external_shipment_id String?
  tracking_number      String?
  tracking_url         String?
  label_url            String?
  status               String             @default("pending")
  cancellation_status  String             @default("not_requested")
  shipping_cost        Decimal?           @db.Decimal(10, 2)
  billing_reference    String?
  notes                String             @default("")
  created_at           DateTime           @default(now()) @db.Timestamptz(6)
  updated_at           DateTime           @default(now()) @db.Timestamptz(6)
  shipping_carriers    shipping_carriers? @relation(fields: [carrier_id], references: [id], onUpdate: NoAction)
  orders               orders             @relation(fields: [order_id], references: [id], onUpdate: NoAction)

  @@index([carrier_id])
  @@index([created_at])
  @@index([order_id])
  @@index([status])
}

model shipping_carriers {
  id                     Int         @id @default(autoincrement())
  key                    String      @unique
  name                   String
  api_base_url           String?
  credentials_ciphertext String?
  is_enabled             Boolean     @default(false)
  show_at_checkout       Boolean     @default(false)
  billing_mode           String      @default("carrier_account")
  created_at             DateTime    @default(now()) @db.Timestamptz(6)
  updated_at             DateTime    @default(now()) @db.Timestamptz(6)
  shipments              shipments[]
}

