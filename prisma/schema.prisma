  enlarged_header_icons     Boolean  @default(false)
  bottom_nav_enabled        Boolean  @default(false)
  sidebar_background        String   @default("#ffffff")
  hide_useful_links         Boolean  @default(false)
  hide_customer_service     Boolean  @default(false)
  announcement_auto_hide    Boolean  @default(false)
  announcement_slide        Boolean  @default(false)
