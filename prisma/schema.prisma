  delivery_fee              Decimal  @default(0) @db.Decimal(10, 2)
  prep_hours                Int      @default(4)
  tax_rate                  Decimal  @default(15) @db.Decimal(5, 2)
  cod_enabled               Boolean  @default(true)
  apple_pay_enabled         Boolean  @default(false)
  bank_transfer_enabled     Boolean  @default(true)
  bank_name                 String   @default("")
  bank_account_name         String   @default("")
  bank_iban                 String   @default("")
  mada_enabled              Boolean  @default(true)
  tabby_enabled             Boolean  @default(true)
  tamara_enabled            Boolean  @default(true)
  show_reviews              Boolean  @default(true)
  show_featured             Boolean  @default(true)
  theme_preset              String   @default("store-emerald")
  logo_url                  String?
  favicon_url               String?
  font_family               String   @default("Tajawal")
  font_url                  String?
  font_weight               String   @default("400,500,700,800")
  use_arabic_numbers        Boolean  @default(true)
  show_breadcrumbs          Boolean  @default(true)
  uniform_product_heights   Boolean  @default(true)
